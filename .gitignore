# Virtual environments -- everyone creates their own, see README.md.
# .venv-ml is the separate training environment from TOOLCHAIN_SETUP.md.
.venv/
.venv-ml/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Recording sessions. These are data, not code: a single 60 s take is tens of
# megabytes, and a full campaign is well over a gigabyte. Use the Shot Logger's
# "Save session to..." to move a finished session somewhere shared instead of
# committing it here.
*.h5
shotlist_working.csv
_logbook.csv
session.json
data/
mes/

# Training. The spectrogram dataset and the raw test-vector input are derived
# data, rebuilt in about a minute by training/build_dataset.py. The trained
# model, its C exports, the test vectors and report.json are committed: the
# embedded port needs them and the pipeline PDF cites them.
training/out/*.npz

# Teammates' notebooks and the model files they produced. They live in the
# teammates' own repositories; this repo's model comes from train_binary.py.
training/Radar_Project.ipynb
training/ssad.ipynb
training/pedestrian_model.keras
training/pedestrian_model.tflite

# OS clutter
.DS_Store
Thumbs.db

# ESP-IDF build products. The firmware source is committed; everything the
# build or the component manager generates is not.
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/
firmware/*/dependencies.lock
